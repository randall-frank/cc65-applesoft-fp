150 INPUT L$: PRINT LEFT$(L$, 39)
160 INPUT L$: PRINT LEFT$(L$, 39)
170 INPUT L$: PRINT LEFT$(L$, 39)
180 INPUT L$: PRINT LEFT$(L$, 39)
190 INPUT L$: PRINT LEFT$(L$, 39)
200 IF L$ <  > "" THEN  GOTO 190
210 INPUT L$: PRINT LEFT$(L$, 39)
220 PRINT D$;"CLOSE /ASFP.ASFP_VERSION"